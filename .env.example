# ---- Database (Neon PostgreSQL) ----
# Neon dashboard > Connect. Use the POOLED string (host contains "-pooler") for the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# The DIRECT (non-pooled) string is used for migrations and backups.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Site ----
# Public URL. If it starts with https, session cookies are marked Secure. Used for sitemap and canonical URLs.
APP_URL=http://localhost:3000
# Long random secret shared with the payment gateway for signing webhooks. The app refuses payments in production without it.
GATEWAY_SECRET=
# Password given to demo accounts by `npm run seed` (demo databases only).
DEMO_PASSWORD=Demo@12345
