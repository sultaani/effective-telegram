# Public URL of the site. If it starts with https, session cookies are marked Secure.
APP_URL=http://localhost:3000
# SQLite file location (default ./data/kcoe.db). Back up this file plus ./data/uploads.
DATABASE_FILE=./data/kcoe.db
# Secret shared with the payment gateway for signing webhooks. CHANGE in production.
GATEWAY_SECRET=demo-only-secret-change-for-production
# Password given to demo accounts by `npm run seed`. Demo only.
DEMO_PASSWORD=Demo@12345
